{
  "project": {
    "name": "U-Net Background Removal",
    "version": "1.0.0",
    "description": "Professional U-Net implementation for automatic background removal",
    "author": "Mandeep Singh",
    "repository": "https://github.com/Mandeep15686/unet-background-removal"
  },
  "training": {
    "default_epochs": 20,
    "default_batch_size": 4,
    "default_learning_rate": 0.0001,
    "default_image_size": 256,
    "default_device": "cuda",
    "default_num_workers": 4,
    "default_accumulation_steps": 2,
    "checkpoint_save_frequency": 5
  },
  "data": {
    "image_dir": "data/images",
    "mask_dir": "data/masks",
    "checkpoint_dir": "checkpoints",
    "output_dir": "outputs",
    "train_split": 0.8,
    "val_split": 0.2
  },
  "inference": {
    "default_threshold": 0.5,
    "default_background": "transparent",
    "supported_formats": [".jpg", ".jpeg", ".png", ".bmp"],
    "default_model": "checkpoints/best_model.pth"
  },
  "model": {
    "architecture": "UNet",
    "in_channels": 3,
    "out_channels": 1,
    "features": [64, 128, 256, 512],
    "loss_function": "BCEWithLogitsLoss"
  },
  "optimization": {
    "optimizer": "Adam",
    "mixed_precision": true,
    "gradient_clipping": false,
    "learning_rate_scheduler": "ReduceLROnPlateau",
    "scheduler_patience": 3,
    "scheduler_factor": 0.5
  },
  "system": {
    "cuda_benchmark": true,
    "pin_memory": true,
    "non_blocking_transfer": true
  }
}
